  "entrada": [],
  "portugolEsperado": "algoritmo \"ParImpar\"\n\nvar\n    i: inteiro\n    n: inteiro\n\ninicio\n    para i de 1 ate 4 faca\n        se i % 2 = 0 entao\n            escreva(i)\n        senao\n            escreva(\"impar\")\n        fim_se\n    fim_para\n    n <- 3\n    enquanto n > 0 faca\n        se n = 2 entao\n            escreva(\"dois\")\n        fim_se\n        n <- n - 1\n    fim_enquanto\nfim_algoritmo\n",
  "saidaEsperada": "impar\n2\nimpar\n4\ndois\n"
