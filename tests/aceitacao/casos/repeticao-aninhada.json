  "entrada": [],
  "portugolEsperado": "algoritmo \"Aninhada\"\n\nvar\n    i: inteiro\n    j: inteiro\n    n: inteiro\n\ninicio\n    para i de 1 ate 2 faca\n        para j de 1 ate 2 faca\n            escreva(i, j)\n        fim_para\n    fim_para\n    para i de 1 ate 2 faca\n        n <- i\n        enquanto n > 0 faca\n            escreva(n)\n            n <- n - 1\n        fim_enquanto\n    fim_para\n    n <- 1\n    enquanto n > 0 faca\n        se verdadeiro entao\n            para i de 1 ate 2 faca\n                escreva(i)\n            fim_para\n        fim_se\n        n <- 0\n    fim_enquanto\nfim_algoritmo\n",
  "saidaEsperada": "11\n12\n21\n22\n1\n2\n1\n1\n2\n"
